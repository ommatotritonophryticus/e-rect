{
  "schema": 1,
  "name": "pack3",
  "description": "Third chiptune set: same roles and loop shape as pack1, different composition",

  "music": {
    "//": "Loop measured from the material: beat = 30976 samples, 32 beats = 8 bars.",
    "//trim_start": "MP3 encoder lead-in. Chosen by minimising the spectral jump at the loop seam.",
    "trim_start": 256,
    "loop_samples": 991232,
    "bpm": 85.4215,
    "bars": 8,
    "target_peak_dbfs": -4.0,
    "layers": [
      { "id": "all_time", "src": "all_time.mp3", "mode": "always" },
      { "id": "leisure",  "src": "leisure.mp3",  "mode": "situation", "group": "base",
        "when": ["calm", "paused"], "fade_in_ms": 700, "fade_out_ms": 700 },
      { "id": "fight",    "src": "fight.mp3",    "mode": "situation", "group": "base",
        "when": ["combat"], "fade_in_ms": 700, "fade_out_ms": 700 },
      { "id": "zombie",   "src": "zombie.mp3",   "mode": "count", "count_of": "zombie",
        "steps_db": [[1, -12], [2, -6], [3, 0]], "mute_when": ["paused"],
        "fade_in_ms": 250, "fade_out_ms": 900, "hold_ms": 700 },
      { "id": "garp",     "src": "garp.mp3",     "mode": "count", "count_of": "flyer",
        "steps_db": [[1, -12], [2, -6], [3, 0]], "mute_when": ["paused"],
        "fade_in_ms": 250, "fade_out_ms": 900, "hold_ms": 700 },
      { "id": "boss",     "src": "boss.mp3",     "mode": "flag", "flag": "boss",
        "mute_when": ["paused"], "fade_in_ms": 120, "fade_out_ms": 1500 }
    ]
  },

  "sfx": {
    "//": "One shared gain keeps the author's balance between the three sounds.",
    "//level": "Sits under the music: these are short transients against a sustained bed, so peak-for-peak they read louder than they measure.",
    "target_peak_dbfs": -8.0,
    "trim_tail_below_dbfs": -60.0,
    "mute_when": ["paused"],
    "sounds": [
      { "id": "hit",  "src": "hit.mp3",  "max_voices": 4, "min_interval_ms": 40 },
      { "id": "jump", "src": "jump.mp3", "max_voices": 2, "min_interval_ms": 60 },
      { "id": "down", "src": "down.mp3", "max_voices": 3, "min_interval_ms": 60 }
    ]
  }
}
