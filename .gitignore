# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Packaged builds. Both ./dist, where tools/release.sh puts the archives, and
# erect-psp/dist. Everything under them is rebuilt by that script.
dist/

# Container builds keep their own target tree, so that a host build and a
# Debian one do not fight over the same fingerprints.
target-docker/

# tools/build_pack.py is Python
__pycache__/
*.py[cod]

# The Android debug key. Kept out of the repository for the ordinary reason -
# it is a signing key - and regenerated by tools/android.sh on first use. It
# only ever signs debug builds, and losing it costs the saved settings of anyone
# who installed one.
android/debug.keystore

# macOS
.DS_Store

